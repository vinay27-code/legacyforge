# ==============================================================
# LegacyForge local development environment
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ==============================================================

# ---- Backend ----
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Local Postgres (matches docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/legacyforge
DB_USERNAME=legacyforge
DB_PASSWORD=legacyforge_dev

# Local Redis (matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string-for-local-only
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# LLM providers (free tiers, no card required)
# Get keys:
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/app/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional (only if you enable them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Frontend ----
API_BASE_URL=http://localhost:8080
